# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Konfigurasi Database Supabase (Opsional: jika kosong, sistem otomatis memakai penyimpanan lokal simulasi)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Secret Key untuk Session JWT (minimal 32 karakter acak)
SESSION_SECRET="sistem_ketidakhadiran_training_session_secret_default_key_2026_xyz_auth_32"

# Kunci Enkripsi AES-256-GCM (64 karakter heksadesimal = 32 byte)
# Digunakan untuk mengenkripsi secret Google Drive Bridge tiap cabang di database.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
